        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "member", "trainer", "department_head", "admin" ]
            },
            "uniqueItems" : true
          },
          "subject" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "roles", "subject" ]
      },
      "MemberAccessResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "relation" : {
            "type" : "string",
            "enum" : [ "self", "guardian" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "invited", "active", "expired", "missing" ]
          }
        },
        "required" : [ "createdAt", "email", "id", "name", "relation", "status" ]
      },
      "MemberRequest" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date"
          },
          "city" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0
          },
          "email" : {
            "type" : [ "string", "null" ],
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "entryDate" : {
            "type" : "string",
            "format" : "date"
          },
          "exitDate" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          },
          "firstName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "gender" : {
            "type" : [ "string", "null" ],
            "enum" : [ "female", "male", "diverse" ]
          },
          "lastName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "memberNumber" : {
            "type" : [ "string", "null" ],
            "maxLength" : 20,
            "minLength" : 0
          },
          "membershipType" : {
            "type" : "string",
            "enum" : [ "active", "passive" ]
          },
          "phone" : {
            "type" : [ "string", "null" ],
            "maxLength" : 50,
            "minLength" : 0
          },
          "postalCode" : {
            "type" : [ "string", "null" ],
            "maxLength" : 10,
            "minLength" : 0
          },
          "street" : {
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0
          },
          "version" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          }
        },
        "required" : [ "birthDate", "entryDate", "firstName", "lastName", "membershipType" ]
      },
      "MemberResponse" : {
        "type" : "object",
        "properties" : {
          "birthDate" : {
            "type" : "string",
            "format" : "date"
          },
          "city" : {
            "type" : [ "string", "null" ]
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "entryDate" : {
            "type" : "string",
            "format" : "date"
          },
          "exitDate" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          },
          "firstName" : {
            "type" : "string"
          },
          "gender" : {
            "type" : [ "string", "null" ],
            "enum" : [ "female", "male", "diverse" ]
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lastName" : {
            "type" : "string"
          },
          "left" : {
            "type" : "boolean"
          },
          "memberNumber" : {
            "type" : [ "string", "null" ]
          },
          "membershipType" : {
            "type" : "string",
            "enum" : [ "active", "passive" ]
          },
          "phone" : {
            "type" : [ "string", "null" ]
          },
          "postalCode" : {
            "type" : [ "string", "null" ]
          },
          "street" : {
            "type" : [ "string", "null" ]
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "birthDate", "entryDate", "firstName", "id", "lastName", "left", "membershipType", "version" ]
      },
      "MyMemberResponse" : {
        "type" : "object",
        "properties" : {
          "member" : {
            "$ref" : "#/components/schemas/MemberResponse"
          },
          "relation" : {
            "type" : "string",
            "enum" : [ "self", "guardian" ]
          }
        },
        "required" : [ "member", "relation" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "description" : "Access-Token von Keycloak (Realm judo, Audience judo-portal-api)",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
