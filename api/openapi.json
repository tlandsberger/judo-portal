  "components" : {
    "schemas" : {
      "ImportResponse" : {
        "type" : "object",
        "properties" : {
          "created" : {
            "type" : "integer",
            "format" : "int32"
          },
          "failed" : {
            "type" : "integer",
            "format" : "int32"
          },
          "rows" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ImportRow"
            }
          },
          "unchanged" : {
            "type" : "integer",
            "format" : "int32"
          },
          "updated" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "created", "failed", "rows", "unchanged", "updated" ]
      },
      "ImportRow" : {
        "type" : "object",
        "properties" : {
          "action" : {
            "type" : "string",
            "enum" : [ "create", "update", "unchanged", "error" ]
          },
          "changes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "errors" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "line" : {
            "type" : "integer",
            "format" : "int64"
          },
          "memberNumber" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "notes" : {
            "type" : "array",
            "items" : {
