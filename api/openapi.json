{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "WTSV Judo – Portal-API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearer" : [ ]
  } ],
  "paths" : {
    "/api/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "member", "trainer", "board", "treasurer", "admin" ]
            },
            "uniqueItems" : true
          },
          "subject" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "roles", "subject" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "description" : "Access-Token von Keycloak (Realm judo, Audience judo-portal-api)",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
