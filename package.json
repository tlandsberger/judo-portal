{
  "name": "judo-portal-assets",
  "private": true,
  "description": "Frontend: Tailwind CSS mit DaisyUI (wird nach portal/static/vendor gebaut), Icons, htmx und E2E-Tests",
  "scripts": {
    "vendor": "node scripts/vendor.mjs && npm run css",
    "css": "tailwindcss -i portal/assets/app.css -o portal/static/vendor/app.css --minify",
    "watch": "tailwindcss -i portal/assets/app.css -o portal/static/vendor/app.css --watch",
    "e2e": "playwright test",
    "help:screenshots": "HELP_SCREENSHOTS=1 playwright test --project=hilfe"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.5",
    "bootstrap-icons": "1.13.2",
    "daisyui": "5.8.2",
    "htmx.org": "2.0.11",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1"
  }
}
