{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "lockFileMaintenance": { "enabled": true, "automerge": true, "schedule": ["before 6am on monday"] },
  "rangeStrategy": "bump",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version des Playwright-Containers für die E2E-Tests",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/", "/^e2e/README\\.md$/"],
      "matchStrings": ["mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\d+\\.\\d+\\.\\d+)-noble"],
      "depNameTemplate": "@playwright/test",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Patch und Minor automatisch mergen, wenn alle Tests grün sind",
      "matchUpdateTypes": ["patch", "minor", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "Major-Updates brauchen eine Freigabe",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Playwright-Paket und -Container immer gemeinsam (Screenshots hängen an der Version)",
      "matchPackageNames": ["@playwright/test", "@axe-core/playwright"],
      "groupName": "Playwright"
    },
    {
      "description": "Python-Image und requires-python immer gemeinsam, sonst passt das Lockfile nicht zum Image",
      "matchPackageNames": ["python"],
      "groupName": "Python"
    },
    {
      "description": "Neue Python-Version (z. B. 3.16) braucht eine Freigabe",
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}
